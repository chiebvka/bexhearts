# Supabase
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx

# Superwall
EXPO_PUBLIC_SUPERWALL_IOS_KEY=your-superwall-ios-key
EXPO_PUBLIC_SUPERWALL_ANDROID_KEY=your-superwall-android-key

# Google Sign-In (B3) — client IDs are NOT secrets and are safe to commit.
# The Web client SECRET lives ONLY in your Supabase/GoTrue config, never here.
# Leave as placeholders to keep the Google button hidden (graceful degradation).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Reversed iOS client ID — required for the iOS native build (added to Info.plist
# via the google-signin config plugin). Get it from the iOS OAuth client.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id

# Sentry crash reporting (H2·M5) — leave the placeholder to keep Sentry OFF
# (graceful no-op; it also never initializes in Expo Go). Real crashes report
# on the dev build once a real DSN is set.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Analytics (PostHog or Mixpanel)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Expo / EAS
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Environment
EXPO_PUBLIC_ENV=development
