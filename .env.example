# Supabase
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx

# Superwall
EXPO_PUBLIC_SUPERWALL_IOS_KEY=your-superwall-ios-key
EXPO_PUBLIC_SUPERWALL_ANDROID_KEY=your-superwall-android-key

# Analytics (PostHog or Mixpanel)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Expo / EAS
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Environment
EXPO_PUBLIC_ENV=development
